# thingino-firmware/user/common/local.fragment
#
# === 常用工具 ===
BR2_PACKAGE_HTOP=y
BR2_PACKAGE_SCREEN=y

# telnet 客户端
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
BR2_PACKAGE_TELNET=y

# FTP/SFTP 客户端
##BR2_PACKAGE_LFTP=y
##BR2_PACKAGE_LFTP_PROTO_FTP=y
##BR2_PACKAGE_LFTP_PROTO_SFTP=y

# ZeroTier VPN
# BR2_PACKAGE_THINGINO_VPN_WIREGUARD is not set
BR2_PACKAGE_THINGINO_VPN_ZEROTIER=y
BR2_INSTALL_LIBSTDCPP=y
BR2_THINGINO_LIBSTDCPP=y
